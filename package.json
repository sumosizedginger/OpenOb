{
  "name": "open-knowledge-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, HTML-first, local-first knowledge workspace",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/web",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace=apps/web",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
