{
  "name": "open-knowledge-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, HTML-first, local-first knowledge workspace",
  "license": "MIT",
  "author": "Joseph R. Long",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22 <=24"
  },
  "scripts": {
    "build": "npm run build --workspace=apps/gateway && npm run build --workspace=apps/web && npm run build --workspace=apps/desktop",
    "build:gateway": "npm run build --workspace=apps/gateway",
    "build:web": "npm run build --workspace=apps/web",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "brand:generate": "node scripts/generate-brand-icons.mjs",
    "package:desktop": "npm run build:web && npm run build:desktop && npm run pack --workspace=apps/desktop",
    "pack:desktop": "npm run build:web && npm run build:desktop && npm run pack --workspace=apps/desktop",
    "dist:desktop": "npm run build:web && npm run build:desktop && npm run dist --workspace=apps/desktop",
    "verify:desktop:release": "node scripts/verify-desktop-release.mjs",
    "test:desktop": "vitest run tests/integrity/desktop-embedded-gateway.test.ts tests/integrity/desktop-wrapper.test.ts",
    "gateway": "node apps/gateway/dist/bin/gateway.js",
    "openob": "node apps/gateway/dist/bin/cli.js",
    "mcp": "node apps/gateway/dist/bin/mcp.js",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert \"@electron|@visual\"",
    "test:e2e:electron": "playwright test --grep \"@electron\" --grep-invert \"@visual\"",
    "capture:screenshots": "playwright test --grep \"@visual\"",
    "dev": "npm run dev --workspace=apps/web",
    "desktop:dev": "npm run dev --workspace=apps/desktop",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:e2e": "npm run test:e2e",
    "verify:full": "npm run verify && npm run verify:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.5"
  }
}
