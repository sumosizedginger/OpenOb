{
  "appId": "com.openob.app",
  "productName": "OpenOb",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "node_modules/**/*",
    "../../apps/gateway/dist/**/*",
    "../../packages/*/dist/**/*"
  ],
  "extraResources": [
    {
      "from": "../web/dist",
      "to": "web",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "mac": {
    "icon": "build/icon.icns",
    "target": ["dmg", "zip"],
    "category": "public.app-category.productivity"
  },
  "linux": {
    "icon": "build/icons",
    "target": ["AppImage"],
    "category": "Utility"
  }
}
